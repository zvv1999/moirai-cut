{
	"name": "moirai-cut",
	"version": "0.1.2",
	"private": true,
	"description": "An open-source, local-first video editor where humans and agents create inside the same visible, editable loop.",
	"license": "MIT",
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=20.9.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"agent:doctor": "bun apps/mcp/src/agent-doctor.mjs",
		"agent:up": "bun apps/mcp/src/agent-up.mjs",
		"brand:render": "bun scripts/brand/render-brand-assets.mjs",
		"build:wasm": "wasm-pack build rust/wasm --target bundler --out-dir pkg",
		"build:web": "bunx --bun turbo run build --filter=@moirai-cut/web",
		"codex:shared-app": "bun apps/web/scripts/launch-codex-shared-app.mjs",
		"deploy:web": "bunx --bun turbo run deploy --filter=@moirai-cut/web",
		"dev:wasm": "cargo watch -w rust/crates -w rust/wasm/src -s 'wasm-pack build rust/wasm --target bundler --out-dir pkg'",
		"dev:web": "bunx --bun turbo run dev --filter=@moirai-cut/web",
		"format:web": "prettier apps/web/src/services/renderer --write",
		"generate:fonts": "npx tsx apps/web/scripts/generate-font-sprites.ts",
		"lint:web": "bunx --bun eslint apps/web/src --ext .ts,.tsx",
		"lint:web:fix": "bunx --bun eslint apps/web/src --ext .ts,.tsx --fix",
		"preview:web": "bunx --bun turbo run preview --filter=@moirai-cut/web",
		"publish:wasm": "bun run build:wasm && npm publish rust/wasm/pkg --access public",
		"release:check": "bun scripts/release/check-public-tree.mjs",
		"release:public-snapshot": "bun scripts/release/create-public-snapshot.mjs",
		"release:sbom": "bun scripts/release/generate-sbom.mjs",
		"release:source": "bun scripts/release/export-source.mjs",
		"setup:local": "bun apps/mcp/src/setup-local.mjs",
		"test": "bun test",
		"test:mcp": "bun --cwd=apps/mcp run test",
		"typecheck:web": "bun --cwd apps/web typecheck"
	},
	"dependencies": {
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"better-auth": "1.6.25",
		"next": "^16.2.12",
		"opencut-wasm": "^0.2.10"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@next/eslint-plugin-next": "^16.2.12",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.8.0",
		"prettier": "^3.9.6",
		"turbo": "^2.10.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0"
	},
	"overrides": {
		"@babel/core": "8.0.1",
		"@hono/node-server": "2.0.12",
		"@protobufjs/utf8": "1.1.2",
		"adm-zip": "0.6.0",
		"body-parser": "2.3.0",
		"brace-expansion": "2.1.3",
		"esbuild": "0.28.1",
		"fast-xml-builder": "1.3.0",
		"form-data": "4.0.6",
		"js-yaml": "3.15.0",
		"postcss": "8.5.25",
		"protobufjs": "7.6.5",
		"qs": "6.15.3",
		"sharp": "0.35.3",
		"tar": "7.5.22"
	},
	"trustedDependencies": [
		"@tailwindcss/oxide"
	]
}
